# Copie para .env.local e preencha com os valores de `supabase status`.
# Apenas a chave pública (anon) vai para o front — nunca a service_role.
# Na Vercel, as mesmas variáveis são configuradas por ambiente:
# Preview → projeto Supabase staging; Production → projeto Supabase produção.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
